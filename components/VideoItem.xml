<?xml version="1.0" encoding="utf-8" ?>
<!-- 620x458 item = 608x446 card + 6 px halo padding; 16:9 poster 608x342, title 2 lines max, meta on a fixed line. Grid gutters are 16 px both ways. -->
<component name="VideoItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <children>
    <!-- 6 px padding inside the item so the focus halo is not clipped by the RowList -->
    <Group translation="[6,6]">
      <Rectangle width="608" height="342" color="0x19191AFF" />
      <Poster id="poster" width="608" height="342" loadDisplayMode="scaleToZoom" />
      <Rectangle id="badgeBg" translation="[520,302]" width="76" height="28" color="0x000000B0" />
      <Label id="dur" translation="[520,302]" width="76" height="28" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:SystemFontFile" size="18" />
      </Label>
      <!-- focus: 4 px halo, 2 px outside the poster on all four sides -->
      <Group id="ring" opacity="0">
        <Rectangle translation="[-6,-6]" width="620" height="4" color="0xFFFFFFFF" />
        <Rectangle translation="[-6,344]" width="620" height="4" color="0xFFFFFFFF" />
        <Rectangle translation="[-6,-2]" width="4" height="346" color="0xFFFFFFFF" />
        <Rectangle translation="[610,-2]" width="4" height="346" color="0xFFFFFFFF" />
      </Group>
      <Label id="title" translation="[0,362]" width="608" wrap="true" maxLines="2" lineSpacing="0" color="0xB8BBC0FF">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
      <Label id="meta" translation="[0,420]" width="608" color="0x6F7378FF">
        <Font role="font" uri="font:SystemFontFile" size="19" />
      </Label>
    </Group>
  </children>
  <script type="text/brightscript"><![CDATA[
    sub onContent()
      c = m.top.itemContent
      if c = invalid then return
      m.top.findNode("poster").uri = c.HDPosterUrl
      m.top.findNode("title").text = c.title
      m.top.findNode("meta").text = c.description
      d = c.ShortDescriptionLine2
      m.top.findNode("dur").text = d
      m.top.findNode("badgeBg").visible = d <> ""
    end sub
    sub onFocus()
      f = m.top.focusPercent
      if not (m.top.rowListHasFocus and m.top.rowHasFocus) then f = 0
      m.top.findNode("ring").opacity = f
      if f > 0.5 then m.top.findNode("title").color = "0xFFFFFFFF" else m.top.findNode("title").color = "0xB8BBC0FF"
    end sub
  ]]></script>
</component>
